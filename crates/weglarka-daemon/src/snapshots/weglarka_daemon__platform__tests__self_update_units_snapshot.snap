=== weglarka-self-update.service ===
# Generated by weglarka — do not edit.
[Unit]
Description=Węglarka self-update check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/weglarka-daemon --config /etc/weglarka/weglarka.toml self-update
=== weglarka-self-update.timer ===
# Generated by weglarka — do not edit.
[Unit]
Description=Węglarka self-update check timer

[Timer]
OnBootSec=5min
OnUnitActiveSec=10min
Persistent=true

[Install]
WantedBy=timers.target
