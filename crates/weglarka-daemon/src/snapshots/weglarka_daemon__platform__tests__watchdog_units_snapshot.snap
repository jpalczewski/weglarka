=== weglarka-watchdog.service ===
# Generated by weglarka — do not edit.
[Unit]
Description=Węglarka self-update watchdog

[Service]
Type=oneshot
TimeoutStartSec=2min
ExecStart=/usr/local/bin/weglarka-daemon --config /etc/weglarka/weglarka.toml supervise
=== weglarka-watchdog.timer ===
# Generated by weglarka — do not edit.
[Unit]
Description=Węglarka self-update watchdog timer

[Timer]
OnBootSec=1min
OnUnitActiveSec=1min
AccuracySec=10s

[Install]
WantedBy=timers.target
