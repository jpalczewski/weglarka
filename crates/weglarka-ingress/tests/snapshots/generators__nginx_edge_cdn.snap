---
source: crates/weglarka-ingress/tests/generators.rs
expression: conf
---
# Generated by weglarka — do not edit.
# tls material: fingerprint 1a2b3c4d
worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
    server_tokens off;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;

    resolver 10.89.0.1 valid=5s ipv6=off;
    resolver_timeout 2s;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    ssl_prefer_server_ciphers off;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    # App name for the access log; set in each `server`.
    log_format weglarka escape=json
        '{"time":"$time_iso8601","app":"$app","host":"$host","remote_addr":"$weglarka_client","peer":"$remote_addr","method":"$request_method","path":"$uri","status":$status,"bytes_sent":$body_bytes_sent,"request_time":$request_time,"upstream_response_time":"$upstream_response_time","request_id":"$request_id","user_agent":"$http_user_agent"}';
    access_log /dev/stdout weglarka;

    set_real_ip_from unix:;
    real_ip_header proxy_protocol;

    # CDN peers (bundled etag 38f79d050aa027e3be3865e495dcc9bc): only they may announce the visitor.
    geo $remote_addr $weglarka_cdn {
        default 0;
        173.245.48.0/20 1;
        103.21.244.0/22 1;
        103.22.200.0/22 1;
        103.31.4.0/22 1;
        141.101.64.0/18 1;
        108.162.192.0/18 1;
        190.93.240.0/20 1;
        188.114.96.0/20 1;
        197.234.240.0/22 1;
        198.41.128.0/17 1;
        162.158.0.0/15 1;
        104.16.0.0/13 1;
        104.24.0.0/14 1;
        172.64.0.0/13 1;
        131.0.72.0/22 1;
        2400:cb00::/32 1;
        2606:4700::/32 1;
        2803:f800::/32 1;
        2405:b500::/32 1;
        2405:8100::/32 1;
        2a06:98c0::/29 1;
        2c0f:f248::/32 1;
    }
    map "$weglarka_cdn:$http_cf_connecting_ip" $weglarka_client {
        default $remote_addr;
        "~^1:(?<ip>[0-9A-Fa-f.:]{3,45})$" $ip;
    }

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $weglarka_client;
    proxy_set_header X-Forwarded-For $weglarka_client;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Request-Id $request_id;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    add_header X-Request-Id $request_id always;

    server {
        listen 8080 default_server;
        listen unix:/run/weglarka-ingress/http.sock default_server proxy_protocol;
        server_name _;
        set $app "-";
        return 444;
    }

    server {
        listen 8443 ssl default_server;
        listen unix:/run/weglarka-ingress/https.sock ssl default_server proxy_protocol;
        ssl_reject_handshake on;
        server_name _;
        return 444;
    }

    server {
        listen 8080;
        listen unix:/run/weglarka-ingress/http.sock proxy_protocol;
        server_name weglarka.example.eu;
        set $app "weglarka";
        location ^~ /.well-known/acme-challenge/ {
            alias /etc/nginx/acme/;
            default_type text/plain;
            limit_except GET {
                deny all;
            }
        }
        location / {
            return 301 https://$host$request_uri;
        }
    }

    server {
        listen 8443 ssl;
        listen unix:/run/weglarka-ingress/https.sock ssl proxy_protocol;
        http2 on;
        ssl_certificate /etc/nginx/tls/weglarka.example.eu.crt;
        ssl_certificate_key /etc/nginx/tls/weglarka.example.eu.key;
        server_name weglarka.example.eu;
        set $app "weglarka";
        client_max_body_size 1048576;
        location ^~ /webhook/ {
            limit_except POST {
                deny all;
            }
            set $upstream "http://weglarka:9180";
            proxy_pass $upstream;
        }
        location / {
            return 404;
        }
    }

    server {
        listen 8080;
        listen unix:/run/weglarka-ingress/http.sock proxy_protocol;
        server_name nz.example.eu;
        set $app "ntfy";
        location ^~ /.well-known/acme-challenge/ {
            alias /etc/nginx/acme/;
            default_type text/plain;
            limit_except GET {
                deny all;
            }
        }
        location / {
            return 301 https://$host$request_uri;
        }
    }
}
