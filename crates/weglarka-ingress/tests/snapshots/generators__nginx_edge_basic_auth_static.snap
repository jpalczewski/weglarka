---
source: crates/weglarka-ingress/tests/generators.rs
expression: edge
---
# Generated by weglarka — do not edit.
# tls material: fingerprint 1a2b3c4d
worker_processes 1;
pid /tmp/nginx.pid;
error_log /var/log/weglarka/error.log warn;

events {
    worker_connections 1024;
}

http {
    # HTTP basic auth (docs/decisions/0081): a map key is a whole Authorization header.
    map_hash_bucket_size 512;

    server_tokens off;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    absolute_redirect off;

    resolver 10.89.0.1 valid=1s ipv6=off;
    resolver_timeout 2s;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    ssl_prefer_server_ciphers off;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    # App name for the access log; `-` unless a `server`/`location` sets it.
    map "" $app {
        default "-";
    }
    log_format weglarka escape=json
        '{"time":"$time_iso8601","app":"$app","host":"$host","remote_addr":"$remote_addr","method":"$request_method","path":"$uri","status":$status,"bytes_sent":$body_bytes_sent,"request_time":$request_time,"upstream_response_time":"$upstream_response_time","upstream_status":"$upstream_status","upstream_addr":"$upstream_addr","upstream_header_time":"$upstream_header_time","request_length":$request_length,"server_protocol":"$server_protocol","request_id":"$request_id","user_agent":"$http_user_agent"}';
    access_log /var/log/weglarka/access.log weglarka;

    map "$remote_addr:$http_x_forwarded_proto" $weglarka_proto {
        default $scheme;
        "unix::https" https;
    }

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $weglarka_proto;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Request-Id $request_id;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Remote-User "";
    proxy_set_header Remote-Groups "";
    proxy_set_header Remote-Name "";
    proxy_set_header Remote-Email "";
    add_header X-Request-Id $request_id always;

    # HTTP basic auth (docs/decisions/0081).
    map $remote_addr $weglarka_probe {
        "unix:" 1;
        default 0;
    }
    map $http_authorization $weglarka_basic_0 {
        default 0;
        include /etc/nginx/auth/docs.map;
    }
    map "$weglarka_probe:$weglarka_basic_0" $weglarka_basic_ok_0 {
        default 0;
        "1:0" 1;
        "0:1" 1;
        "1:1" 1;
    }

    server {
        listen 8080 default_server;
        listen unix:/run/weglarka-probe/probe.sock default_server;
        server_name _;
        set $app "-";
        return 444;
    }

    server {
        listen 8443 ssl default_server;
        ssl_reject_handshake on;
        server_name _;
        return 444;
    }

    server {
        listen 8080;
        server_name weglarka.example.eu;
        set $app "weglarka";
        location ^~ /.well-known/acme-challenge/ {
            alias /etc/nginx/acme/;
            default_type text/plain;
            limit_except GET {
                deny all;
            }
        }
        location / {
            return 301 https://$host$request_uri;
        }
    }

    server {
        listen 8443 ssl;
        http2 on;
        ssl_certificate /etc/nginx/tls/weglarka.example.eu.crt;
        ssl_certificate_key /etc/nginx/tls/weglarka.example.eu.key;
        server_name weglarka.example.eu;
        set $app "weglarka";
        client_max_body_size 1048576;
        location ^~ /webhook/ {
            limit_except POST {
                deny all;
            }
            set $upstream "http://weglarka:9180";
            proxy_pass $upstream;
        }
        location / {
            return 404;
        }
    }

    server {
        listen 8080;
        server_name docs.example.eu;
        set $app "docs";
        location ^~ /.well-known/acme-challenge/ {
            alias /etc/nginx/acme/;
            default_type text/plain;
            limit_except GET {
                deny all;
            }
        }
        location / {
            return 301 https://$host$request_uri;
        }
    }

    server {
        listen unix:/run/weglarka-probe/probe.sock;
        listen 8443 ssl;
        http2 on;
        ssl_certificate /etc/nginx/tls/docs.example.eu.crt;
        ssl_certificate_key /etc/nginx/tls/docs.example.eu.key;
        server_name docs.example.eu;
        set $app "docs";
        client_max_body_size 67108864;
        location / {
            if ($weglarka_basic_ok_0 = 0) {
                add_header WWW-Authenticate 'Basic realm="Restricted", charset="UTF-8"' always;
                return 401;
            }
            root /etc/nginx/sites/docs/current;
            types {
                text/html html htm;
                text/css css;
                application/javascript js mjs;
                application/json json webmanifest;
                image/svg+xml svg;
                font/woff woff;
                font/woff2 woff2;
                application/wasm wasm;
                application/xml xml;
                text/plain txt;
                image/png png;
                image/jpeg jpg jpeg;
                image/gif gif;
                image/x-icon ico;
            }
            default_type application/octet-stream;
            index index.html;
            autoindex off;
            try_files $uri $uri/index.html =404;
            limit_except GET HEAD {
                deny all;
            }
        }
    }
}
