# Generated by weglarka — do not edit.
# tls material: fingerprint 1a2b3c4d
worker_processes 1;
pid /tmp/nginx.pid;
error_log /var/log/weglarka/error.log warn;

events {
    worker_connections 1024;
}

http {
    server_tokens off;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    absolute_redirect off;

    resolver 10.89.0.1 valid=1s ipv6=off;
    resolver_timeout 2s;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    ssl_prefer_server_ciphers off;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    # App name for the access log; `-` unless a `server`/`location` sets it.
    map "" $app {
        default "-";
    }
    log_format weglarka escape=json
        '{"time":"$time_iso8601","app":"$app","host":"$host","remote_addr":"$remote_addr","method":"$request_method","path":"$uri","status":$status,"bytes_sent":$body_bytes_sent,"request_time":$request_time,"upstream_response_time":"$upstream_response_time","request_id":"$request_id","user_agent":"$http_user_agent"}';
    access_log /var/log/weglarka/access.log weglarka;

    map "$remote_addr:$http_x_forwarded_proto" $weglarka_proto {
        default $scheme;
        "unix::https" https;
    }

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $weglarka_proto;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Request-Id $request_id;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Remote-User "";
    proxy_set_header Remote-Groups "";
    proxy_set_header Remote-Name "";
    proxy_set_header Remote-Email "";
    add_header X-Request-Id $request_id always;

    # Forward auth (docs/decisions/0052).
    map $remote_addr $weglarka_probe {
        "unix:" 1;
        default 0;
    }
    map $wg_redirect $wg_redirect_or_portal {
        "" "https://auth.example.eu/";
        default $wg_redirect;
    }


    # Security headers of a container app, added only when the app did not send them (#497).
    map $upstream_http_x_content_type_options $wg_api_x_content_type_options {
        "" "nosniff";
        default "";
    }
    map $upstream_http_x_frame_options $wg_api_x_frame_options {
        "" "DENY";
        default "";
    }
    map $upstream_http_referrer_policy $wg_api_referrer_policy {
        "" "strict-origin-when-cross-origin";
        default "";
    }
    map $upstream_http_strict_transport_security $wg_api_strict_transport_security {
        "" "max-age=31536000";
        default "";
    }
    map $upstream_http_content_security_policy $wg_api_content_security_policy {
        "" "default-src 'self'";
        default "";
    }
    map $upstream_http_x_content_type_options $wg_web_x_content_type_options {
        "" "nosniff";
        default "";
    }
    map $upstream_http_x_frame_options $wg_web_x_frame_options {
        "" "DENY";
        default "";
    }
    map $upstream_http_referrer_policy $wg_web_referrer_policy {
        "" "strict-origin-when-cross-origin";
        default "";
    }
    map $upstream_http_content_security_policy $wg_web_content_security_policy {
        "" "default-src 'none'";
        default "";
    }
    server {
        listen 8080 default_server;
        listen unix:/run/weglarka-probe/probe.sock default_server;
        server_name _;
        set $app "-";
        return 444;
    }

    server {
        listen 8443 ssl default_server;
        ssl_reject_handshake on;
        server_name _;
        return 444;
    }

    server {
        listen 8080;
        server_name weglarka.example.eu;
        set $app "weglarka";
        location ^~ /.well-known/acme-challenge/ {
            alias /etc/nginx/acme/;
            default_type text/plain;
            limit_except GET {
                deny all;
            }
        }
        location / {
            return 301 https://$host$request_uri;
        }
    }

    server {
        listen 8080;
