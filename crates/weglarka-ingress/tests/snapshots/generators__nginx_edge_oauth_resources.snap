        }
        location = /.well-known/oauth-protected-resource/alpha/rpc {
            if ($wg_oauth_origin = "") { return 404; }
            default_type application/json;
            add_header Cache-Control "public, max-age=300" always;
            add_header Access-Control-Allow-Origin "*" always;
            add_header Access-Control-Allow-Methods "GET, OPTIONS" always;
            add_header Access-Control-Allow-Headers "*" always;
            if ($request_method = OPTIONS) { return 204; }
            return 200 '{"resource":"$wg_oauth_origin/alpha/rpc","authorization_servers":["https://auth.example.eu"],"bearer_methods_supported":["header"]}';
        }
        location = /.well-known/oauth-protected-resource/beta/rpc {
            if ($wg_oauth_origin = "") { return 404; }
            default_type application/json;
            add_header Cache-Control "public, max-age=300" always;
            add_header Access-Control-Allow-Origin "*" always;
            add_header Access-Control-Allow-Methods "GET, OPTIONS" always;
            add_header Access-Control-Allow-Headers "*" always;
