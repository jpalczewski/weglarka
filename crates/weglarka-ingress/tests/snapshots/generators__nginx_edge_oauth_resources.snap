        listen 8443 ssl;
        http2 on;
        ssl_certificate /etc/nginx/tls/shared.example.eu.crt;
        ssl_certificate_key /etc/nginx/tls/shared.example.eu.key;
        server_name shared.example.eu;
        set $app "-";
        client_max_body_size 67108864;
        location = /alpha {
            set $app "alpha";
            set $upstream "http://alpha:3002";
            proxy_pass $upstream;
        }
        location ^~ /alpha/ {
            set $app "alpha";
            set $upstream "http://alpha:3002";
            proxy_pass $upstream;
        }
        location = /beta {
            set $app "beta";
            set $upstream "http://beta:3003";
            proxy_pass $upstream;
        }
        location ^~ /beta/ {
            set $app "beta";
            set $upstream "http://beta:3003";
            proxy_pass $upstream;
        }
        location = /alpha/rpc {
            set $app "alpha";
            set $upstream "http://alpha:3002";
            proxy_pass $upstream;
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }
        location ^~ /alpha/rpc/ {
            set $app "alpha";
            set $upstream "http://alpha:3002";
            proxy_pass $upstream;
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }
        location = /beta/rpc {
            set $app "beta";
            set $upstream "http://beta:3003";
            proxy_pass $upstream;
            proxy_buffering off;
