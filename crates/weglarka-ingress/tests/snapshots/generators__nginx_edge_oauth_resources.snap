---
source: crates/weglarka-ingress/tests/generators.rs
expression: conf
---
# Generated by weglarka — do not edit.
# tls material: fingerprint 1a2b3c4d
worker_processes 1;
pid /tmp/nginx.pid;
error_log /var/log/weglarka/error.log warn;

events {
    worker_connections 1024;
}

http {
    server_tokens off;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    absolute_redirect off;

    resolver 10.89.0.1 valid=1s ipv6=off;
    resolver_timeout 2s;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    ssl_prefer_server_ciphers off;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    # App name for the access log; `-` unless a `server`/`location` sets it.
    map "" $app {
        default "-";
    }
    log_format weglarka escape=json
        '{"time":"$time_iso8601","app":"$app","host":"$host","remote_addr":"$remote_addr","method":"$request_method","path":"$uri","status":$status,"bytes_sent":$body_bytes_sent,"request_time":$request_time,"upstream_response_time":"$upstream_response_time","upstream_status":"$upstream_status","upstream_addr":"$upstream_addr","upstream_header_time":"$upstream_header_time","request_length":$request_length,"server_protocol":"$server_protocol","request_id":"$request_id","user_agent":"$http_user_agent"}';
    access_log /var/log/weglarka/access.log weglarka;

    map "$remote_addr:$http_x_forwarded_proto" $weglarka_proto {
        default $scheme;
        "unix::https" https;
    }

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $weglarka_proto;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Request-Id $request_id;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Remote-User "";
    proxy_set_header Remote-Groups "";
    proxy_set_header Remote-Name "";
    proxy_set_header Remote-Email "";
    add_header X-Request-Id $request_id always;

    # Forward auth (docs/decisions/0052).
    map $remote_addr $weglarka_probe {
        "unix:" 1;
        default 0;
    }
    map $wg_redirect $wg_redirect_or_portal {
        "" "https://auth.example.eu/";
        default $wg_redirect;
    }

    # OAuth-protected resources (#215, ADR 0078): the origin each resource's metadata names.
    map $host $wg_oauth_origin {
        api.example.eu "https://api.example.eu";
        panel.example.eu "https://panel.example.eu";
        shared.example.eu "https://shared.example.eu";
        default "";
    }

    server {
        listen 8080 default_server;
        listen unix:/run/weglarka-probe/probe.sock default_server;
        server_name _;
        set $app "-";
        return 444;
    }

    server {
        listen 8443 ssl default_server;
        ssl_reject_handshake on;
        server_name _;
        return 444;
    }

    server {
        listen 8080;
        server_name weglarka.example.eu;
        set $app "weglarka";
        location ^~ /.well-known/acme-challenge/ {
            alias /etc/nginx/acme/;
            default_type text/plain;
            limit_except GET {
                deny all;
            }
        }
        location / {
            return 301 https://$host$request_uri;
        }
    }

    server {
        listen 8443 ssl;
        http2 on;
        ssl_certificate /etc/nginx/tls/weglarka.example.eu.crt;
        ssl_certificate_key /etc/nginx/tls/weglarka.example.eu.key;
        server_name weglarka.example.eu;
        set $app "weglarka";
        client_max_body_size 1048576;
        location ^~ /webhook/ {
            limit_except POST {
                deny all;
            }
            set $upstream "http://weglarka:9180";
            proxy_pass $upstream;
        }
        location / {
            return 404;
        }
    }

    server {
        listen 8080;
        server_name api.example.eu;
        set $app "api";
        location ^~ /.well-known/acme-challenge/ {
            alias /etc/nginx/acme/;
            default_type text/plain;
            limit_except GET {
                deny all;
            }
        }
        location / {
            return 301 https://$host$request_uri;
        }
    }

    server {
        listen unix:/run/weglarka-probe/probe.sock;
        listen 8443 ssl;
        http2 on;
        ssl_certificate /etc/nginx/tls/api.example.eu.crt;
        ssl_certificate_key /etc/nginx/tls/api.example.eu.key;
        server_name api.example.eu;
        set $app "api";
        client_max_body_size 67108864;
        location / {
            set $upstream "http://api:3001";
            proxy_pass $upstream;
        }
        location = /v1/rpc {
            set $upstream "http://api:3001";
            proxy_pass $upstream;
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }
        location ^~ /v1/rpc/ {
            set $upstream "http://api:3001";
            proxy_pass $upstream;
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }
        location = /.well-known/oauth-protected-resource/v1/rpc {
            if ($wg_oauth_origin = "") { return 404; }
            default_type application/json;
            add_header Cache-Control "public, max-age=300" always;
            add_header Access-Control-Allow-Origin "*" always;
            add_header Access-Control-Allow-Methods "GET, OPTIONS" always;
            add_header Access-Control-Allow-Headers "*" always;
            if ($request_method = OPTIONS) { return 204; }
            return 200 '{"resource":"$wg_oauth_origin/v1/rpc","authorization_servers":["https://auth.example.eu"],"bearer_methods_supported":["header"]}';
        }
        location = /.well-known/oauth-authorization-server {
            return 302 https://auth.example.eu/.well-known/oauth-authorization-server;
        }
    }

    server {
        listen 8080;
        server_name auth.example.eu;
        set $app "authelia";
        location ^~ /.well-known/acme-challenge/ {
            alias /etc/nginx/acme/;
            default_type text/plain;
            limit_except GET {
                deny all;
            }
        }
        location / {
            return 301 https://$host$request_uri;
        }
    }

    server {
        listen unix:/run/weglarka-probe/probe.sock;
        listen 8443 ssl;
        http2 on;
        ssl_certificate /etc/nginx/tls/auth.example.eu.crt;
        ssl_certificate_key /etc/nginx/tls/auth.example.eu.key;
        server_name auth.example.eu;
        set $app "authelia";
        client_max_body_size 67108864;
        location / {
            set $upstream "http://authelia:9091";
            proxy_pass $upstream;
        }
    }

    server {
        listen 8080;
        server_name panel.example.eu;
        set $app "panel";
        location ^~ /.well-known/acme-challenge/ {
            alias /etc/nginx/acme/;
            default_type text/plain;
            limit_except GET {
                deny all;
            }
        }
        location / {
            return 301 https://$host$request_uri;
        }
    }

    server {
        listen unix:/run/weglarka-probe/probe.sock;
        listen 8443 ssl;
        http2 on;
        ssl_certificate /etc/nginx/tls/panel.example.eu.crt;
        ssl_certificate_key /etc/nginx/tls/panel.example.eu.key;
        server_name panel.example.eu;
        set $app "panel";
        client_max_body_size 67108864;
        location = /internal/weglarka/authz {
            internal;
            if ($weglarka_probe) {
                return 200;
            }
            set $wg_idp "http://authelia:9091";
            proxy_pass $wg_idp/api/authz/auth-request;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header Connection "";
            proxy_set_header Remote-User "";
            proxy_set_header Remote-Groups "";
            proxy_set_header Remote-Name "";
            proxy_set_header Remote-Email "";
            proxy_set_header X-Original-Method $request_method;
            proxy_set_header X-Original-URL https://$host$request_uri;
            proxy_set_header X-Forwarded-For $remote_addr;
        }
        location / {
            if ($request_uri ~* "^[^?]*(;|%3b|\\\\|%5c|%25|%2e|%2f|//|/\.\.?(/|\?|$))") {
                return 400;
            }
            auth_request /internal/weglarka/authz;
            auth_request_set $wg_user $upstream_http_remote_user;
            auth_request_set $wg_groups $upstream_http_remote_groups;
            auth_request_set $wg_name $upstream_http_remote_name;
            auth_request_set $wg_email $upstream_http_remote_email;
            auth_request_set $wg_redirect $upstream_http_location;
            error_page 401 =302 $wg_redirect_or_portal;
            set $upstream "http://panel:3000";
            proxy_pass $upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto $weglarka_proto;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Request-Id $request_id;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Remote-User $wg_user;
            proxy_set_header Remote-Groups $wg_groups;
            proxy_set_header Remote-Name $wg_name;
            proxy_set_header Remote-Email $wg_email;
            add_header X-Request-Id $request_id always;
        }
        location = /mcp {
            if ($request_uri ~* "^[^?]*(;|%3b|\\\\|%5c|%25)") {
                return 400;
            }
            set $upstream "http://panel:3000";
            proxy_pass $upstream;
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }
        location ^~ /mcp/ {
            if ($request_uri ~* "^[^?]*(;|%3b|\\\\|%5c|%25)") {
                return 400;
            }
            set $upstream "http://panel:3000";
            proxy_pass $upstream;
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }
        location = /.well-known/oauth-protected-resource/mcp {
            if ($wg_oauth_origin = "") { return 404; }
            default_type application/json;
            add_header Cache-Control "public, max-age=300" always;
            add_header Access-Control-Allow-Origin "*" always;
            add_header Access-Control-Allow-Methods "GET, OPTIONS" always;
            add_header Access-Control-Allow-Headers "*" always;
            if ($request_method = OPTIONS) { return 204; }
            return 200 '{"resource":"$wg_oauth_origin/mcp","authorization_servers":["https://auth.example.eu"],"bearer_methods_supported":["header"]}';
        }
        location = /.well-known/oauth-authorization-server {
            return 302 https://auth.example.eu/.well-known/oauth-authorization-server;
        }
    }

    server {
        listen 8080;
        server_name shared.example.eu;
        set $app "-";
        location ^~ /.well-known/acme-challenge/ {
            alias /etc/nginx/acme/;
            default_type text/plain;
            limit_except GET {
                deny all;
            }
        }
        location / {
