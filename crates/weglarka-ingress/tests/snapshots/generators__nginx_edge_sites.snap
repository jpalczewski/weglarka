---
source: crates/weglarka-ingress/tests/generators.rs
expression: edge
---
# Generated by weglarka — do not edit.
# tls material: fingerprint 1a2b3c4d
worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
    server_tokens off;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;

    resolver 10.89.0.1 valid=1s ipv6=off;
    resolver_timeout 2s;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    ssl_prefer_server_ciphers off;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    # App name for the access log; `-` unless a `server`/`location` sets it.
    map "" $app {
        default "-";
    }
    log_format weglarka escape=json
        '{"time":"$time_iso8601","app":"$app","host":"$host","remote_addr":"$remote_addr","method":"$request_method","path":"$uri","status":$status,"bytes_sent":$body_bytes_sent,"request_time":$request_time,"upstream_response_time":"$upstream_response_time","request_id":"$request_id","user_agent":"$http_user_agent"}';
    access_log /dev/stdout weglarka;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Request-Id $request_id;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Remote-User "";
    proxy_set_header Remote-Groups "";
    proxy_set_header Remote-Name "";
    proxy_set_header Remote-Email "";
    add_header X-Request-Id $request_id always;

    server {
        listen 8080 default_server;
        listen unix:/run/weglarka-probe/probe.sock default_server;
        server_name _;
        set $app "-";
        return 444;
    }

    server {
        listen 8443 ssl default_server;
        ssl_reject_handshake on;
        server_name _;
        return 444;
    }

    server {
        listen 8080;
        server_name weglarka.example.eu;
        set $app "weglarka";
        location ^~ /.well-known/acme-challenge/ {
            alias /etc/nginx/acme/;
            default_type text/plain;
            limit_except GET {
                deny all;
            }
        }
        location / {
            return 301 https://$host$request_uri;
        }
    }

    server {
        listen 8443 ssl;
        http2 on;
        ssl_certificate /etc/nginx/tls/weglarka.example.eu.crt;
        ssl_certificate_key /etc/nginx/tls/weglarka.example.eu.key;
        server_name weglarka.example.eu;
        set $app "weglarka";
        client_max_body_size 1048576;
        location ^~ /webhook/ {
            limit_except POST {
                deny all;
            }
            set $upstream "http://weglarka:9180";
            proxy_pass $upstream;
        }
        location / {
            return 404;
        }
    }

    server {
        listen 8080;
        server_name app.example.eu;
        set $app "-";
        location ^~ /.well-known/acme-challenge/ {
            alias /etc/nginx/acme/;
            default_type text/plain;
            limit_except GET {
                deny all;
            }
        }
        location / {
            return 301 https://$host$request_uri;
        }
    }

    server {
        listen unix:/run/weglarka-probe/probe.sock;
        listen 8443 ssl;
        http2 on;
        ssl_certificate /etc/nginx/tls/app.example.eu.crt;
        ssl_certificate_key /etc/nginx/tls/app.example.eu.key;
        server_name app.example.eu;
        set $app "-";
        client_max_body_size 67108864;
        location = /api {
            set $app "api";
            set $upstream "http://api:3000";
            proxy_pass $upstream;
        }
        location ^~ /api/ {
            set $app "api";
            set $upstream "http://api:3000";
            proxy_pass $upstream;
        }
        location = /docs.v2 {
            set $app "docs";
            rewrite ^ /index.html break;
            root /etc/nginx/sites/docs/current;
            index index.html;
            autoindex off;
            try_files $uri $uri/index.html =404;
            limit_except GET HEAD {
                deny all;
            }
        }
        location ^~ /docs.v2/ {
            set $app "docs";
            rewrite ^/docs\.v2/(.*)$ /$1 break;
            root /etc/nginx/sites/docs/current;
            index index.html;
            autoindex off;
            try_files $uri $uri/index.html =404;
            limit_except GET HEAD {
                deny all;
            }
        }
    }

    server {
        listen 8080;
        server_name www.example.eu;
        set $app "landing";
        location ^~ /.well-known/acme-challenge/ {
            alias /etc/nginx/acme/;
            default_type text/plain;
            limit_except GET {
                deny all;
            }
        }
        location / {
            return 301 https://$host$request_uri;
        }
    }

    server {
        listen unix:/run/weglarka-probe/probe.sock;
        listen 8443 ssl;
        http2 on;
        ssl_certificate /etc/nginx/tls/www.example.eu.crt;
        ssl_certificate_key /etc/nginx/tls/www.example.eu.key;
        server_name www.example.eu;
        set $app "landing";
        client_max_body_size 67108864;
        location / {
            root /etc/nginx/sites/landing/current;
            index index.html;
            autoindex off;
            try_files $uri $uri/index.html =404;
            limit_except GET HEAD {
                deny all;
            }
        }
    }
}
