---
source: crates/weglarka-ingress/tests/generators.rs
expression: conf
---
# Generated by weglarka — do not edit.
worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
    server_tokens off;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;

    resolver 10.89.0.1 valid=1s ipv6=off;
    resolver_timeout 2s;

    set_real_ip_from 10.89.0.0/24;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    geo $realip_remote_addr $weglarka_trusted {
        default 0;
        10.89.0.0/24 1;
    }
    map "$weglarka_trusted:$http_x_forwarded_proto" $weglarka_proto {
        default $scheme;
        "1:https" https;
        "1:http" http;
    }
    map "$weglarka_trusted:$http_x_forwarded_proto" $weglarka_redirect_https {
        default 0;
        "~^1:.+" 1;
        "1:https" 0;
        "1:wss" 0;
    }
    map "$weglarka_trusted:$http_x_forwarded_for" $weglarka_xff {
        default $remote_addr;
        "~^1:(?<chain>.+)$" $chain;
    }
    map "$weglarka_trusted:$http_x_forwarded_host" $weglarka_fwd_host {
        default $host;
        "~^1:(?<fhost>.+)$" $fhost;
    }

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    # App name for the access log; `-` unless a `server`/`location` sets it.
    map "" $app {
        default "-";
    }
    log_format weglarka escape=json
        '{"time":"$time_iso8601","app":"$app","host":"$host","remote_addr":"$remote_addr","method":"$request_method","path":"$uri","status":$status,"bytes_sent":$body_bytes_sent,"request_time":$request_time,"upstream_response_time":"$upstream_response_time","request_id":"$request_id","user_agent":"$http_user_agent"}';
    # Paths an app asked to keep out of the access log (while they succeed).
    map "$app $uri" $weglarka_skip_path {
        default 0;
        "~^forgejo /api/actions/runner\.v1\.RunnerService/" 1;
        "~^forgejo /healthz$" 1;
        "~^v1 /v1/poll/" 1;
    }
    map "$weglarka_skip_path:$status" $weglarka_loggable {
        default 1;
        "~^1:[123][0-9][0-9]$" 0;
    }
    access_log /dev/stdout weglarka if=$weglarka_loggable;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $weglarka_xff;
    proxy_set_header X-Forwarded-Proto $weglarka_proto;
    proxy_set_header X-Forwarded-Host $weglarka_fwd_host;
    proxy_set_header X-Request-Id $request_id;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    add_header X-Request-Id $request_id always;

    server {
        listen 8080 default_server;
        server_name _;
        set $app "-";
        return 444;
    }

    server {
        listen 8080;
        server_name weglarka.example.eu;
        set $app "weglarka";
        if ($weglarka_redirect_https) {
            return 301 https://$host$request_uri;
        }
        client_max_body_size 1048576;
        location ^~ /webhook/ {
            limit_except POST {
                deny all;
            }
            set $upstream "http://weglarka:9180";
            proxy_pass $upstream;
        }
        location / {
            return 404;
        }
    }

    server {
        listen 8080;
        server_name git.example.eu;
        set $app "forgejo";
        if ($weglarka_redirect_https) {
            return 301 https://$host$request_uri;
        }
        client_max_body_size 67108864;
        location / {
            set $upstream "http://forgejo:3000";
            proxy_pass $upstream;
        }
    }

    server {
        listen 8080;
        server_name plain.example.eu;
        set $app "plain";
        if ($weglarka_redirect_https) {
            return 301 https://$host$request_uri;
        }
        client_max_body_size 67108864;
        location / {
            set $upstream "http://plain:3001";
            proxy_pass $upstream;
        }
    }

    server {
        listen 8080;
        server_name shared.example.eu;
        set $app "-";
        if ($weglarka_redirect_https) {
            return 301 https://$host$request_uri;
        }
        client_max_body_size 67108864;
        location / {
            set $app "web";
            set $upstream "http://web:3003";
            proxy_pass $upstream;
        }
        location = /v1 {
            set $app "v1";
            set $upstream "http://v1:3002";
            proxy_pass $upstream;
        }
        location ^~ /v1/ {
            set $app "v1";
            set $upstream "http://v1:3002";
            proxy_pass $upstream;
        }
    }
}
