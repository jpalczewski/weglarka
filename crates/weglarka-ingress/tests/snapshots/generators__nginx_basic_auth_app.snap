---
source: crates/weglarka-ingress/tests/generators.rs
expression: behind
---
# Generated by weglarka — do not edit.
worker_processes 1;
pid /tmp/nginx.pid;
error_log /var/log/weglarka/error.log warn;

events {
    worker_connections 1024;
}

http {
    # HTTP basic auth (docs/decisions/0081): a map key is a whole Authorization header.
    map_hash_bucket_size 512;

    server_tokens off;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    absolute_redirect off;

    resolver 10.89.0.1 valid=1s ipv6=off;
    resolver_timeout 2s;

    set_real_ip_from 10.89.0.0/24;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    geo $realip_remote_addr $weglarka_trusted {
        default 0;
        10.89.0.0/24 1;
    }
    map "$weglarka_trusted:$http_x_forwarded_proto" $weglarka_proto_peer {
        default $scheme;
        "1:https" https;
        "1:http" http;
    }
    map "$remote_addr:$http_x_forwarded_proto" $weglarka_proto {
        default $weglarka_proto_peer;
        "unix::https" https;
    }
    map "$weglarka_trusted:$http_x_forwarded_proto" $weglarka_redirect_https {
        default 0;
        "~^1:.+" 1;
        "1:https" 0;
        "1:wss" 0;
    }
    map "$weglarka_trusted:$http_x_forwarded_for" $weglarka_xff {
        default $remote_addr;
        "~^1:(?<chain>.+)$" $chain;
    }
    map "$weglarka_trusted:$http_x_forwarded_host" $weglarka_fwd_host {
        default $host;
        "~^1:(?<fhost>.+)$" $fhost;
    }

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    # App name for the access log; `-` unless a `server`/`location` sets it.
    map "" $app {
        default "-";
    }
    log_format weglarka escape=json
        '{"time":"$time_iso8601","app":"$app","host":"$host","remote_addr":"$remote_addr","method":"$request_method","path":"$uri","status":$status,"bytes_sent":$body_bytes_sent,"request_time":$request_time,"upstream_response_time":"$upstream_response_time","upstream_status":"$upstream_status","upstream_addr":"$upstream_addr","upstream_header_time":"$upstream_header_time","request_length":$request_length,"server_protocol":"$server_protocol","request_id":"$request_id","user_agent":"$http_user_agent"}';
    access_log /var/log/weglarka/access.log weglarka;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $weglarka_xff;
    proxy_set_header X-Forwarded-Proto $weglarka_proto;
    proxy_set_header X-Forwarded-Host $weglarka_fwd_host;
    proxy_set_header X-Request-Id $request_id;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Remote-User "";
    proxy_set_header Remote-Groups "";
    proxy_set_header Remote-Name "";
    proxy_set_header Remote-Email "";
    add_header X-Request-Id $request_id always;

    # HTTP basic auth (docs/decisions/0081).
    map $remote_addr $weglarka_probe {
        "unix:" 1;
        default 0;
    }
    map $http_authorization $weglarka_basic_0 {
        default 0;
        include /etc/nginx/auth/panel.map;
    }
    map "$weglarka_probe:$weglarka_basic_0" $weglarka_basic_ok_0 {
        default 0;
        "1:0" 1;
        "0:1" 1;
        "1:1" 1;
    }

    server {
        listen 8080 default_server;
        listen unix:/run/weglarka-probe/probe.sock default_server;
        server_name _;
        set $app "-";
        return 444;
    }

    server {
        listen 8080;
        server_name weglarka.example.eu;
        set $app "weglarka";
        if ($weglarka_redirect_https) {
            return 301 https://$host$request_uri;
        }
        client_max_body_size 1048576;
        location ^~ /webhook/ {
            limit_except POST {
                deny all;
            }
            set $upstream "http://weglarka:9180";
            proxy_pass $upstream;
        }
        location / {
            return 404;
        }
    }

    server {
        listen 8080;
        listen unix:/run/weglarka-probe/probe.sock;
        server_name panel.example.eu;
        set $app "panel";
        if ($weglarka_redirect_https) {
            return 301 https://$host$request_uri;
        }
        client_max_body_size 67108864;
        location / {
            if ($weglarka_basic_ok_0 = 0) {
                add_header WWW-Authenticate 'Basic realm="Restricted", charset="UTF-8"' always;
                return 401;
            }
            set $upstream "http://panel:3000";
            proxy_pass $upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $weglarka_xff;
            proxy_set_header X-Forwarded-Proto $weglarka_proto;
            proxy_set_header X-Forwarded-Host $weglarka_fwd_host;
            proxy_set_header X-Request-Id $request_id;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Authorization "";
            proxy_set_header Remote-User "";
            proxy_set_header Remote-Groups "";
            proxy_set_header Remote-Name "";
            proxy_set_header Remote-Email "";
            add_header X-Request-Id $request_id always;
        }
        location = /health {
            if ($request_uri ~* "^[^?]*(;|%3b|\\\\|%5c|%25)") {
                return 400;
            }
            set $upstream "http://panel:3000";
            proxy_pass $upstream;
        }
    }
}
